//@version=6
indicator("Correlation Heatmap Matrix by Novatrix Capital", "CorrMatrix", overlay = false)

// --- Color Settings ---
appearance           = input.string("Darkmode", "Appearance", options = ["Darkmode", "Lightmode"])

grp_color      = "Heatmap Gradient Settings"
c_neg_input    = input.color(#801922, "color for -1.0 (negative)", group = grp_color)
c_neut_input   = input.color(#b8b8b8, "color for  0.0 (neutral)", group = grp_color)
c_pos_input    = input.color(#1b5e20, "color for +1.0 (positive)", group = grp_color)

//txtcolor       = input.color(color.new(color.white, 0), title = 'text color (labels)')

Corr_period    = input.int(100, 'Correlation period', group = 'Logic')
Size           = input.string(size.normal , 'Table size' , options = [size.auto, size.tiny, size.small, size.normal, size.large, size.huge], group = 'Display')
tablePosition  = input.string("Middle Center", "Table position", options = ["Middle Center", "Top Right", "Top Left", "Bottom Right", "Bottom Left"], group= 'Display')
Position_Chart = input.bool(false, 'Table on chart', group = 'Display')

Position = switch tablePosition
    "Bottom Left"   => position.bottom_left
    "Bottom Right"  => position.bottom_right
    "Top Left"      => position.top_left
    "Top Right"     => position.top_right
    "Middle Center" => position.middle_center
    => position.top_right


group_colors   = "COLORS"
colorBorder    = input.color(color.new(#252727, 0), title = "Border Color", group = group_colors)
colorHeaderBg  = input.color(color.new(#4d0fbe, 0), title = "Table Header Color", group = group_colors)
// Setup Colors
bool isDark = (appearance == "Darkmode")
color colorBackgroundDM    = color.new(#110f14, 0)
color colorBackgroundLM    = color.new(#ffffff, 0)
color colorTextDM          = color.white
color colorTextLM          = color.new(#000000, 0)

color bgColor = isDark ? colorBackgroundDM : colorBackgroundLM
color txtColor = isDark ? colorTextDM : colorTextLM

// --- FUNCTIONS ---

get_dynamic_color(float corr, color c_neg, color c_neut, color c_pos) =>
    corr < 0 ? color.from_gradient(corr, -1.0, 0.0, c_neg, c_neut) : color.from_gradient(corr, 0.0, 1.0, c_neut, c_pos)

get_text_color(float corr) =>
    (corr >= -1.0 and corr < -0.4) or (corr >= 0.8 and corr <= 1.0) ? #F0F0F0 : #2E2E2E

c(float s_x, float s_y) => ta.correlation(s_x, s_y, Corr_period)


// --- SYMBOL INPUTS ---
Market = input.string('Forex', 'Select Market', ['Forex', 'Stock', 'Crypto', 'Custom'], group = 'Symbol Custom')
Sym_1  = input.symbol('OANDA:EURUSD', group = 'Symbols'), Sym_2  = input.symbol('OANDA:GBPUSD', group = 'Symbols')
Sym_3  = input.symbol('OANDA:USDJPY', group = 'Symbols'), Sym_4  = input.symbol('OANDA:AUDUSD', group = 'Symbols')
Sym_5  = input.symbol('OANDA:USDCAD', group = 'Symbols'), Sym_6  = input.symbol('OANDA:USDCHF', group = 'Symbols')
Sym_7  = input.symbol('OANDA:NZDUSD', group = 'Symbols'), Sym_8  = input.symbol('OANDA:EURGBP', group = 'Symbols')
Sym_9  = input.symbol('OANDA:EURJPY', group = 'Symbols'), Sym_10 = input.symbol('OANDA:GBPJPY', group = 'Symbols')
Sym_11 = input.symbol('', group = 'Symbols'),       Sym_12 = input.symbol('', group = 'Symbols')
Sym_13 = input.symbol('', group = 'Symbols'),       Sym_14 = input.symbol('', group = 'Symbols')
Sym_15 = input.symbol('', group = 'Symbols'),       Sym_16 = input.symbol('', group = 'Symbols')
Sym_17 = input.symbol('', group = 'Symbols'),       Sym_18 = input.symbol('', group = 'Symbols')
Sym_19 = input.symbol('', group = 'Symbols'),       Sym_20 = input.symbol('', group = 'Symbols')
Sym_21 = input.symbol('', group = 'Symbols'),       Sym_22 = input.symbol('', group = 'Symbols')
Sym_23 = input.symbol('', group = 'Symbols'),       Sym_24 = input.symbol('', group = 'Symbols')
Sym_25 = input.symbol('', group = 'Symbols'),       Sym_26 = input.symbol('', group = 'Symbols')
Sym_27 = input.symbol('', group = 'Symbols'),       Sym_28 = input.symbol('', group = 'Symbols')

switch Market
    'Forex' => 
        Sym_1 := 'EURUSD', Sym_2 := 'EURJPY', Sym_3 := 'EURGBP', Sym_4 := 'EURCAD', Sym_5 := 'EURCHF', Sym_6 := 'EURNZD', Sym_7 := 'EURAUD' 
        Sym_8 := 'GBPUSD', Sym_9 := 'GBPJPY', Sym_10 := 'GBPAUD', Sym_11 := 'GBPCAD', Sym_12 := 'GBPCHF', Sym_13 := 'GBPNZD'
        Sym_14 := 'USDJPY', Sym_15 := 'USDCAD', Sym_16 := 'USDCHF'
        Sym_17 := 'AUDUSD', Sym_18 := 'AUDNZD', Sym_19 := 'AUDJPY', Sym_20 := 'AUDCAD', Sym_21 := 'AUDCHF'
        Sym_22 := 'NZDUSD', Sym_23 := 'NZDCAD', Sym_24 := 'NZDCHF', Sym_25 := 'NZDJPY'
        Sym_26 := 'CADJPY', Sym_27 := 'CADCHF', Sym_28 := 'CHFJPY'
    'Stock' => 
        Sym_1 := 'NVDA', Sym_2 := 'AAPL', Sym_3 := 'GOOG', Sym_4 := 'CVS', Sym_5 := 'META', Sym_6 := 'MSFT', Sym_7 := 'AMZN', Sym_8 := 'AVGO', Sym_9 := 'TSLA', Sym_10 := 'BRK.B'
        Sym_11 := 'UNH', Sym_12 := 'V', Sym_13 := 'JPM', Sym_14 := 'WMT', Sym_15 := 'LLY', Sym_16 := 'ORCL', Sym_17 := 'HD', Sym_18 := 'JNJ', Sym_19 := 'MA', Sym_20 := 'COST'
    'Crypto' => 
        Sym_1 := 'BTCUSD', Sym_2 := 'ETHUSD', Sym_3 := 'BNBUSD', Sym_4 := 'XRPUSD', Sym_5 := 'SOLUSD', Sym_6 := 'ADAUSD', Sym_7 := 'DOGEUSD', Sym_8 := 'AVAXUSD', Sym_9 := 'DOTUSD', Sym_10 := 'TRXUSD'
        Sym_11 := 'LTCUSD', Sym_12 := 'LINKUSD', Sym_13 := 'UNIUSD', Sym_14 := 'ATOMUSD', Sym_15 := 'ICPUSD', Sym_16 := 'ARBUSD', Sym_17 := 'APTUSD', Sym_18 := 'FILUSD', Sym_19 := 'OPUSD', Sym_20 := 'USDT.D'


