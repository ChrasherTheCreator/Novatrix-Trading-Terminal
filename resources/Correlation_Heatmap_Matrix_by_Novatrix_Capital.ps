// --- LOGIC: FILTERING THE ACTIVE ASSETS ---
all_symbols = array.from(Sym_1, Sym_2, Sym_3, Sym_4, Sym_5, Sym_6, Sym_7, Sym_8, Sym_9, Sym_10, Sym_11, Sym_12, Sym_13, Sym_14, Sym_15, Sym_16, Sym_17, Sym_18, Sym_19, Sym_20, Sym_21, Sym_22, Sym_23, Sym_24, Sym_25, Sym_26, Sym_27, Sym_28)
active_indices = array.new_int(0)

for i = 0 to 27
    if array.get(all_symbols, i) != ""
        array.push(active_indices, i)

int active_count = array.size(active_indices)

// --- TABLE ---
var table Table = Position_Chart ? table.new(Position, 29, 30, bgcolor = bgColor, border_width=1, border_color= colorBorder, frame_width=2, frame_color=colorBorder, force_overlay = true) : table.new(Position, 29, 30, bgcolor = bgColor, border_width=1, border_color=colorBorder, frame_width=2, frame_color=colorBorder, force_overlay = false)

if barstate.islast
    table.clear(Table, 0, 0, 28, 29)
    
    if active_count > 0
        table.merge_cells(Table, 0, 0, active_count, 0)
        table.cell(Table, 0, 0, "NOVATRIX Correlation Matrix", bgcolor = colorHeaderBg, text_color = color.white, text_size = Size)

        for i = 0 to active_count - 1
            int real_idx_i = array.get(active_indices, i)
            string sym_name_i = array.get(all_symbols, real_idx_i)
            string display_name = sym_name_i
            string[] name_parts = str.split(sym_name_i, ":")
            if array.size(name_parts) > 1
                display_name := array.get(name_parts, array.size(name_parts) - 1)

            table.cell(Table, i + 1, 1, display_name, text_color = txtColor, text_size = Size)
            table.cell(Table, 0, i + 2,  ' ' + display_name + ' ', text_color = txtColor, text_size = Size)

            for j = 0 to active_count - 1
                int real_idx_j = array.get(active_indices, j)
                float val = 0.0
                
                if i == j
                    val := 1.0
                else
                    int r = math.min(real_idx_i, real_idx_j)
                    int c = math.max(real_idx_i, real_idx_j)
                    int flat_idx = 0
    
                    if r > 0
                        for k = 0 to r - 1
                            flat_idx += (28 - k) 
    
                    flat_idx += (c - r)
    
                    val := array.get(all_corrs, flat_idx)
                
                color cell_bg = get_dynamic_color(val, c_neg_input, c_neut_input, c_pos_input)
                color cell_txt = get_text_color(val)
                
                table.cell(Table, i + 1, j + 2, str.tostring(val, "#.###"), 
                     bgcolor = cell_bg, 
                     text_color = cell_txt, 
                     text_size = Size, 
                     tooltip = str.tostring(val, "#.###"))